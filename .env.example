# ---------------------------------------------------------------------------
# Multilingual Communication Assistant - example environment file
# Copy to `.env` and adjust. NEVER commit the real `.env` file.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Application -----------------------------------------------------------------
APP_ENV=development
APP_NAME=multilingual-communication-assistant
LOG_LEVEL=INFO
# When "true", message bodies are NEVER written to logs (recommended in prod).
LOG_MESSAGE_CONTENT=false
API_V1_PREFIX=/api

# Database --------------------------------------------------------------------
# Production / docker: PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/multilingual_assistant
# For a zero-infrastructure local run, swap the line above for:
# DATABASE_URL=sqlite+aiosqlite:///./app.db
DATABASE_ECHO=false

# CORS -----------------------------------------------------------------------
# Comma separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI provider ----------------------------------------------------------------
# mock  -> fully offline, rule-based, no API key required (default for dev)
# openai-> OpenAI chat completions (requires OPENAI_API_KEY)
# local -> any OpenAI-compatible local server, e.g. Ollama
AI_PROVIDER=mock

# OpenAI ---------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2

# Local / open-source model (Ollama, llama.cpp server, vLLM, LM Studio) -------
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=not-needed
LOCAL_MODEL=llama3.1
LOCAL_TIMEOUT_SECONDS=120

# Privacy / retention ---------------------------------------------------------
# Number of days a completed workspace is kept before it can be purged.
DATA_RETENTION_DAYS=30
